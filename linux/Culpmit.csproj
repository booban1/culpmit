<Project Sdk="Microsoft.NET.Sdk">
  <!-- Culpmit for Linux: the Windows app's core (windows/Core, free of Windows) with a Linux layer of its own: /proc for
       the readings, systemd scopes and paused slices for the caps, the tray item over D-Bus, the panel in Avalonia. One
       self-contained `culpmit` file per processor, zero runtime install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>culpmit</AssemblyName>
    <RootNamespace>Culpmit</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Culpmit</Product>
    <Company>Simon Booban</Company>
    <Copyright>MIT</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);build.noindex/**;bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- the publish: one file holding the runtime and Avalonia's native parts, unpacked on first start -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../windows/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/culpmit.png" LogicalName="culpmit.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>
</Project>
