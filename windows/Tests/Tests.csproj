<Project Sdk="Microsoft.NET.Sdk">
  <!-- The core's checks (windows/Core, shared with Linux), on modern .NET on the Mac and on .NET Framework 4.8 on GitHub's
       Windows runner, the framework Culpmit.exe runs on -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Culpmit.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/**/*.cs" />
  </ItemGroup>
</Project>
